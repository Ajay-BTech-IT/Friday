# ---------------- Database (REQUIRED) ----------------
# Postgres with pgvector. The DB user must be able to run CREATE EXTENSION.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ---------------- Owner (single user) ----------------
OWNER_EMAIL=you@example.com
OWNER_NAME=Ajay
OWNER_TIMEZONE=Asia/Kolkata

# ---------------- LLM (REQUIRED) ----------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://127.0.0.1:11434
# nomic-embed-text returns 768 dimensions, matching the database. Gemini (EMBEDDING_PROVIDER=gemini, model
# gemini-embedding-001) also fits but its vectors are a different space: memories are re-embedded automatically on start.
EMBEDDING_DIM=768

# ---------------- Server ----------------
HOST=127.0.0.1
PORT=8000
# REQUIRED when HOST=0.0.0.0 (phone on the same Wi-Fi). Everything needs "Authorization: Bearer <token>".
API_AUTH_TOKEN=

# ---------------- Proactivity ----------------
# Reminders marked "by email" are mailed to this address (your own). Nothing else is ever auto-sent.
# true = every "remind me" reminder is also mailed (say "in-app only" to skip one); false = only when you ask for mail
EMAIL_REMINDERS_DEFAULT=true
REMINDER_EMAIL=
DAILY_NOTIFY_CAP=8
REMINDER_POLL_SECONDS=30
EXTRACT_POLL_SECONDS=20
DESKTOP_NOTIFICATIONS=true
# Hour:minute (owner timezone) when overnight jobs run
OVERNIGHT_JOB_TIME=03:30
EVENING_BRIEFING_TIME=20:30

# ---------------- Voice (Murf Falcon). Replies always stream as text + audio ----------------
# List voices: GET https://api.murf.ai/v1/speech/voices?model=FALCON  (header api-key)
MURF_API_KEY=
MURF_MODEL=falcon-2
# full = send the whole reply to Murf once (it handles chunking); sentence = speak sentence by sentence (earlier audio)
TTS_MODE=full
MURF_VOICE_MALE=en-IN-nikhil
MURF_VOICE_FEMALE=en-IN-pooja

# ---------------- YouTube (OPTIONAL) ----------------
# Search/play videos. Create an API key in Google Cloud (APIs & Services > Credentials) with the YouTube Data API v3
# enabled. Leave blank to use your Google login instead (open /auth/google/start once to grant YouTube access).
YOUTUBE_API_KEY=

# ---------------- Google: Gmail + Calendar (OPTIONAL) ----------------
# Leave blank to run without Gmail/Calendar. Then open /auth/google/start once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---------------- Held for the mobile phase (unused now) ----------------
# FCM_SERVICE_ACCOUNT_PATH=credentials/firebase-service-account.json
